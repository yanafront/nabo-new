NUXT_RETAIL_API_BASE=https://naboback-production.up.railway.app
# Локальный бэкенд: http://localhost:5031

# Яндекс JavaScript API — публичный ключ, ограничьте домены в кабинете Яндекса.
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=
# HTTP Геокодер — серверный ключ для поиска адресов на русском.
NUXT_YANDEX_GEOCODER_API_KEY=

# Включить после деплоя отдельного сервиса nabo-recipes на Railway.
NUXT_MANAGED_RECIPES_ENABLED=false
# Cloudflare R2: только серверные переменные. До подключения работает HTTPS-ссылка на фото.
NUXT_RECIPE_PHOTOS_ACCOUNT_ID=
NUXT_RECIPE_PHOTOS_ACCESS_KEY_ID=
NUXT_RECIPE_PHOTOS_SECRET_ACCESS_KEY=
NUXT_RECIPE_PHOTOS_BUCKET=
NUXT_RECIPE_PHOTOS_PUBLIC_BASE=

# Separate Railway recipes service, server-side only. Enable after /health succeeds.
NUXT_RECIPES_API_BASE=
